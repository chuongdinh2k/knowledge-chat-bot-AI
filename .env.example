# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_chat

# Database URL - Use 'postgres' hostname when running API in Docker
# Use 'localhost' when running API locally
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_chat
# For Docker: DATABASE_URL=postgresql://postgres:postgres@postgres:5432/knowledge_chat

# ============================================
# Redis Configuration
# ============================================
# Use 'localhost' when running API locally
REDIS_URL=redis://localhost:6379/0
# For Docker: REDIS_URL=redis://redis:6379/0

# ============================================
# Celery Configuration
# ============================================
# Use 'localhost' when running API locally
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# For Docker: CELERY_BROKER_URL=redis://redis:6379/0
# For Docker: CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================
# OpenAI Configuration
# ============================================
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# ============================================
# Application Configuration
# ============================================
DEBUG=False
API_TITLE=Knowledge Chat Bot API
API_VERSION=1.0.0

# ============================================
# File Upload Configuration
# ============================================
# Local path when running API locally
UPLOAD_DIR=./uploads
# Docker path: UPLOAD_DIR=/app/uploads